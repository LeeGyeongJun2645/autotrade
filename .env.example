# ═══════════════════════════════════════════════════════════════
#  자동매매 시스템 환경변수 예시
#  이 파일을 .env 로 복사 후 실제 값 입력:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── 실행 모드 ────────────────────────────────────────────────────
# PAPER = 모의투자 (기본값, 안전)  |  LIVE = 실전투자 (주의!)
TRADE_MODE=PAPER

# ── 한국투자증권 KIS API ─────────────────────────────────────────
# 발급: https://apiportal.koreainvestment.com
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# 모의투자 계좌번호 (8자리, 예: 50123456)
KIS_ACCOUNT_NO=your_account_number_here
# 계좌 상품코드 (일반 위탁: 01)
KIS_ACCOUNT_PROD_CODE=01

# 모의투자 기본 URL
KIS_BASE_URL_PAPER=https://openapivts.koreainvestment.com:29443
# 실전투자 기본 URL (TRADE_MODE=LIVE 일 때 자동 전환)
KIS_BASE_URL_LIVE=https://openapi.koreainvestment.com:9443

# ── 업비트 API ──────────────────────────────────────────────────
# 발급: https://upbit.com/mypage/open_api_management
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# ── 텔레그램 봇 ─────────────────────────────────────────────────
# 봇 생성: @BotFather 에서 /newbot 명령
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 알림 받을 채팅 ID (본인 채팅 ID, @userinfobot 에서 확인)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── ML / 뉴스 감성 분석 (선택) ──────────────────────────────────
# CryptoPanic API 토큰 (없으면 뉴스 기능 비활성화, ML 기본 동작)
# 무료 계정: https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=your_cryptopanic_token_here

# OpenAI API 키 (설정 시 GPT-4o-mini LLM 감성분석 활성화, 없으면 VADER 폴백)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── 데이터베이스 ─────────────────────────────────────────────────
# SQLite (기본, 파일 경로)
DATABASE_URL=sqlite+aiosqlite:///./autotrade.db
# PostgreSQL 전환 시 (배포 환경)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autotrade

# ── 리스크 관리 기본값 ───────────────────────────────────────────
# 손절 비율 (음수, 예: -0.02 = -2%)
STOP_LOSS_RATE=-0.02
# 익절 비율 (예: 0.04 = +4%)
TAKE_PROFIT_RATE=0.04
# 트레일링 스탑 간격 (예: 0.01 = 1%)
TRAILING_STOP_RATE=0.01
# 1종목 최대 포지션 비율 (예: 0.20 = 전체 자본의 20%)
MAX_POSITION_RATIO=0.20

# ── 전략 기본 파라미터 ───────────────────────────────────────────
# 변동성 돌파 K값 (기본 0.5)
VOLATILITY_K=0.5
# 이동평균 단기/장기 기간
MA_SHORT=20
MA_LONG=60
# RSI 기간 및 임계값
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ── API Rate Limit ───────────────────────────────────────────────
# KIS 초당 최대 호출 수 (공식 제한: 20)
KIS_RATE_LIMIT_PER_SEC=18

# ── FastAPI 서버 ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# 프론트엔드 주소 (CORS 허용 목록)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
